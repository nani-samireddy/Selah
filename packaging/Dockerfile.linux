FROM ubuntu:26.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build python3 git ca-certificates patchelf \
    qt6-base-dev qt6-base-private-dev qt6-declarative-dev qt6-declarative-private-dev \
    qt6-multimedia-dev qt6-svg-dev qt6-shadertools-dev qt6-quicktimeline-dev \
    qml6-module-qtquick qml6-module-qtquick-controls qml6-module-qtquick-layouts \
    qml6-module-qtquick-window qml6-module-qtquick-templates qml6-module-qtquick-dialogs \
    qml6-module-qtquick-effects qml6-module-qtqml qml6-module-qtqml-models \
    qml6-module-qtqml-workerscript qml6-module-qtcore qml6-module-qtmultimedia \
    qml6-module-qtquick-timeline && rm -rf /var/lib/apt/lists/*
WORKDIR /src
